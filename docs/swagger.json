{
    "swagger": "2.0",
    "info": {
        "description": "API untuk aplikasi membaca buku PDF",
        "title": "BooksReader API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8081",
    "basePath": "/api/v1",
    "paths": {
        "/books": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Tanpa parameter: semua buku (perilaku lama). Dengan salah satu dari q, sort, page, atau limit: hasil dipaginasi dan response berisi field \"meta\".",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Books"
                ],
                "summary": "Ambil daftar buku milik user yang login",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Cari di judul atau pengarang",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "created_at, title, author, published_year. Awali '-' untuk menurun. Default -created_at",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Halaman, mulai dari 1 (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Jumlah per halaman, 1-100 (default 20)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.BookSummaryResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Mengembalikan data buku yang baru dibuat. thumbnail_url masih kosong sampai worker selesai membuat sampul.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Books"
                ],
                "summary": "Upload buku PDF baru",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Judul buku",
                        "name": "title",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Nama pengarang",
                        "name": "author",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Tahun terbit",
                        "name": "published_year",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "File PDF (Max 75MB)",
                        "name": "pdf_file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.BookDetailResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
